{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/404", "dest": "/api/404.php" },
    { "src": "/farming", "dest": "/api/farming.php" },
    { "src": "/litepaper", "dest": "/assets/litepaper/TOKIE_litepaper.pdf" },
    { "src": "/info", "dest": "/api/info.php" },
    { "src": "/nft", "dest": "/api/nft.php" },
    { "src": "/pools", "dest": "/api/pools.php" },
    { "src": "/privacy-policy", "dest": "/api/privacy-policy.php" },
    { "src": "/referral", "dest": "/api/referral.php" },
    { "src": "/roadmap", "dest": "/api/roadmap.php" },
    { "src": "/terms-condition", "dest": "/api/terms-condition.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
